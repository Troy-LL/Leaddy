# ── Usage tiers ───────────────────────────────────────────────────────────────
# Level 1 (dashboard only):     docker-compose up
# Level 2 (simple agent):       docker-compose --profile simple-agent up
# Level 3 (OpenClaw):           docker-compose --profile openclaw up
# Level 3 (Hermes):             docker-compose --profile hermes up

# Level 2 simple agent
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
# Ollama (free, local): LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=llama3
LLM_MODEL=gpt-4o-mini

# Scrapers (optional)
LI_AT=
GOOGLE_SERP_KEY=

# Database (Docker named volume)
DATABASE_URL=sqlite:////app/data/leads.db

# Internal
SCRAPLING_MCP_URL=http://scrapling_mcp:8001
